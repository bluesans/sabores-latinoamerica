# Plantilla de configuración del backend Node (Fase 1).
# Copiá este archivo a ".env" y ajustá los valores. Nunca versiones ".env".

DB_HOST=127.0.0.1
DB_NAME=sabores_latinoamerica
DB_USER=root
DB_PASS=

# Clave larga y aleatoria para firmar los JWT.
# IMPORTANTE: durante la transición, backend/.env REUSA el MISMO JWT_SECRET que
# api/.env: los access tokens deben validar en ambos lados (cutover y rollback).
# Generá una con (mínimo 32 caracteres; el comando de abajo genera 64):
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Duración del access token en segundos.
JWT_TTL=900

# Duración del refresh token en días.
SESSION_DAYS=7

# Cabeceras de respuesta para peticiones cruzadas (CORS).
# Vacío = mismo origen, no se emite ninguna cabecera CORS (recomendado).
# * = abierto a cualquier origen sin credenciales.
# Origen exacto, p. ej. https://tudominio.com = lo permite y agrega credenciales.
CORS_ORIGIN=

# Cookie de refresh token: Secure solo por HTTPS.
# auto = la marca automáticamente si la request llega por HTTPS (recomendado).
# 1 = siempre Secure (solo si servís por HTTPS). 0 = nunca (solo HTTP local).
# El v1 también acepta true como sinónimo de 1.
COOKIE_SECURE=auto

# Cuenta admin inicial que crea `npm run create-admin`.
# El registro web SIEMPRE crea usuarios comunes; admin solo existe si lo creás acá.
ADMIN_USER=
ADMIN_PASS=

# 1 para ver errores detallados (solo desarrollo).
APP_DEBUG=0

# 1 = register exige aceptar términos, privacidad y confirmar edad.
# Se activa recién en el todo 40 (por defecto 0 = retrocompatible).
CONSENT_STRICT=0

# Puerto interno de Node (Apache proxya hacia acá en el cutover).
PORT=3001

# Prefijo público bajo el que Node sirve la API (mismo que el PHP v1).
BASE_PATH=/sabores-latinoamerica/api

# Path de la cookie de refresh (idéntico al del PHP v1).
COOKIE_PATH=/sabores-latinoamerica/api

# Trust proxy de Fastify: 0 = sin proxy (dev directo). Detrás de Apache en el
# cutover pasa a 127.0.0.1. IMPORTANTE: con 0 bajo ProxyPass el socket es
# 127.0.0.1 para TODOS los clientes y el rate limit queda compartido.
TRUST_PROXY=0
