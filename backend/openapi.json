            },
            "type": "array"
          },
          "ingredients": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "ok": {
            "type": "boolean"
          },
          "recipes": {
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "ok",
          "recipes",
          "countries",
          "ingredients"
