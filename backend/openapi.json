              "easy",
              "medium",
              "hard"
            ],
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "ingredients": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "name": {
            "type": "string"
          },
          "time_minutes": {
            "type": [
              "integer",
              "string",
              "null"
            ]
          },
          "youtube_id": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "country_id"
        ],
        "type": "object"
      },
      "AdminRecipeSuccess": {
