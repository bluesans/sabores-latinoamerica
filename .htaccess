# Security headers for the whole app (HTML, assets and API).
# "always" covers Apache-generated error responses (403/404) too.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

# El backend PHP v1 y el frontend v1 retirados viven bajo legacy/.
# Bloquear todo el árbol para que no se sirvan fuentes, .env ni vendor.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^legacy(?:/|$) - [F,L,NC]
    # Defensa en profundidad si se restaura el DocumentRoot pre-F2:
    RewriteRule ^(?:\.git|\.omo|\.codegraph|backend|db|frontend|node_modules)(?:/|$) - [F,L,NC]
</IfModule>

<FilesMatch "(^\.env|\.env$|\.env\.)">
    Require all denied
</FilesMatch>