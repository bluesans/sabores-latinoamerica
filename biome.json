{
    "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
    "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "defaultBranch": "master" },
    "files": { "ignoreUnknown": true, "includes": ["js/**/*.js", "!js/vendor/**", "!js/__tests__/**"] },
    "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 4, "lineWidth": 320, "lineEnding": "crlf" },
    "linter": { "enabled": true, "rules": { "preset": "recommended" } },
    "javascript": { "formatter": { "quoteStyle": "single", "jsxQuoteStyle": "single", "quoteProperties": "preserve", "arrowParentheses": "asNeeded", "semicolons": "always", "bracketSpacing": true, "trailingCommas": "none" } },
    "overrides": [
        {
            "includes": ["js/admin.js", "js/app.js", "js/auth.js", "js/data.js", "js/map.js", "js/panel.js", "js/util/dom.js"],
            "formatter": { "enabled": false }
        }
    ]
}
