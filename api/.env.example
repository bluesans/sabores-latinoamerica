# Plantilla de configuración.
# Copiá este archivo a ".env" y ajustá los valores.

DB_HOST=127.0.0.1
DB_NAME=sabores_latinoamerica
DB_USER=root
DB_PASS=

# Clave larga y aleatoria para firmar los JWT.
# Generá una con:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
JWT_SECRET=

# Duración del access token en segundos.
JWT_TTL=900

# Duración del refresh token en días.
SESSION_DAYS=7

# Origen permitido para CORS.
# Mismo origen (front y API en el mismo host): * alcanza.
# API servida desde otro dominio: poné el origen exacto, p. ej. https://tudominio.com
CORS_ORIGIN=*

# Cookie de refresh token: Secure solo por HTTPS.
# auto = la marca automáticamente si la request llega por HTTPS (recomendado).
# 1 = siempre Secure (solo si servís por HTTPS). 0 = nunca (solo HTTP local).
COOKIE_SECURE=auto

# Cuenta admin inicial que crea api/bin/create-admin.php.
# El registro web SIEMPRE crea usuarios comunes; admin solo existe si lo creás acá.
ADMIN_USER=
ADMIN_PASS=

# 1 para ver errores detallados (solo desarrollo).
APP_DEBUG=0
