# Plantilla de configuración.
# Copiá este archivo a ".env" y ajustá los valores.

DB_HOST=127.0.0.1
DB_NAME=sabores_latinoamerica
DB_USER=root
DB_PASS=

# Clave larga y aleatoria para firmar los JWT.
# Generá una con:
# php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
JWT_SECRET=

# Duración del access token en segundos.
JWT_TTL=900

# Duración del refresh token en días.
SESSION_DAYS=7

# Origen permitido para CORS.
# Para desarrollo local simple: *
# Para producción: https://tudominio.com
CORS_ORIGIN=*

# 1 para ver errores detallados (solo desarrollo).
APP_DEBUG=0